@using Microsoft.EntityFrameworkCore
@inject ArbioFlow.Data.ArbioDbContext Db;

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    // (clé, contrôleur, libellé)
    var menu = new List<(string Key, string Controller, string Label)>
    {
        ("preparation",       "Home",         "Préparation"),
        ("retour",            "Retours",          "Retour"),
        ("factures-validees", "FacturesValidees", "Factures validées"),
        ("reste-a-livrer",    "ResteALivrer",     "Reste à livrer"),
        ("reservations",      "Reservations",     "Réservations"),
        ("synthese",          "Synthese",         "Synthèse réservation"),
        ("transferts",        "Transferts",       "Transferts inter-magasins")
    };
}

@{
    var nomUtilisateur = User.Identity?.IsAuthenticated == true
        ? (User.Identity.Name ?? "Utilisateur")
        : "Invité";

    int nbValidations = 0;
    int nbDemande = 0;

    if (nomUtilisateur.Contains("admin"))
    {
        nbValidations = await Db.UtilisateursArbio
            .CountAsync(u => !u.Actif && u.PendingHash == null);

        nbDemande = await Db.UtilisateursArbio
            .CountAsync(u => !u.Actif && u.PendingHash != null);  
    }

    var parts = nomUtilisateur.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initiales = parts.Length >= 2
        ? $"{parts[0][0]}{parts[1][0]}"
        : nomUtilisateur.Length >= 2 ? nomUtilisateur[..2] : nomUtilisateur;
    initiales = initiales.ToUpper();
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArbioFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArbioFlow.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/arbioflow.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="~/js/arbioflow-validation.js" asp-append-version="true"></script>
</head>
<body class="af-body">
    <header class="af-header">
        <nav class="navbar navbar-expand-lg af-navbar">
            <div class="container-fluid">
                <a class="af-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo.png" alt="AR" class="af-logo" />
                    <span>ARBIOFLOW</span>
                </a>

                <button class="navbar-toggler af-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

               
                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav af-nav me-auto">
                        @foreach (var m in menu)
                        {
                            var active = string.Equals(currentController, m.Controller, StringComparison.OrdinalIgnoreCase);
                            <li class="nav-item">
                                <a asp-controller="@m.Controller" asp-action="Index"
                                   class="af-link @(active ? "active" : "")"
                                   data-view="@m.Key">@m.Label</a>
                            </li>
                        }
                    </ul>

                    <div class="af-user d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="depot-info">Dépôt : @User.FindFirst("DeIntitule")?.Value</span>
                        }

                        @if (nomUtilisateur.Contains("admin"))
                        {
                            <a asp-controller="Admin" asp-action="Demandes"
                               class="nav-link af-icon-link"
                               title="Approbation mdp : @nbDemande en attente">
                                <i class="bi bi-key-fill"></i>
                                @if (nbDemande > 0)
                                {
                                    <span class="af-badge @(nbDemande < 10 ? "af-badge--single" : "")">
                                        @(nbDemande > 99 ? "99+" : nbDemande.ToString())
                                    </span>
                                }
                            </a>

                            <a asp-controller="Admin" asp-action="Validations"
                               class="nav-link af-icon-link"
                               title="Validation user : @nbValidations en attente">
                                <i class="bi bi-person-check-fill"></i>
                                @if (nbValidations > 0)
                                {
                                    <span class="af-badge @(nbValidations < 10 ? "af-badge--single" : "")">
                                        @(nbValidations > 99 ? "99+" : nbValidations.ToString())
                                    </span>
                                }
                            </a>
                        }

                        <span class="af-avatar">@initiales</span>
                        <span class="af-uname">@nomUtilisateur</span>

                        <form asp-controller="Home" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Déconnexion" aria-label="Déconnexion">
                                <i class="bi bi-box-arrow-right"></i>Déconnexion
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="af-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="af-footer">
        <div class="af-footer-inner">
            <p class="af-footer-text">
                Développé par l'équipe <strong>IT Arbiochem</strong>
                &copy; @DateTime.Now.Year
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        const depot = @Json.Serialize(User.FindFirst("DeIntitule")?.Value);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>