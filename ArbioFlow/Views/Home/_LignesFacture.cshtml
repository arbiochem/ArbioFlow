@model IReadOnlyList<ArbioFlow.Models.LigneFactureDto>
@using System.Globalization

@{
    var historique = (ViewData["Historique"] as IEnumerable<ArbioFlow.Models.HistoriqueValidationDto>
                     ?? Enumerable.Empty<ArbioFlow.Models.HistoriqueValidationDto>()).ToList();
    var validateur = ViewData["Validateur"] as string ?? "";
    var noFacture = ViewData["DoPiece"] as string ?? "";
    var autoDate = DateTime.Now.ToString("dd/MM/yyyy");
    var autoHeure = DateTime.Now.ToString("HH:mm");
    var fr = CultureInfo.GetCultureInfo("fr-FR");
    var inv = CultureInfo.InvariantCulture;

    // Informations de livraison déjà enregistrées en base pour cette facture (peut être null)
    var liv = ViewData["Livraison"] as ArbioFlow.Models.LivraisonFacture;

    // Ajoute la valeur enregistrée si elle ne fait pas partie de la liste par défaut
    List<string> Opts(string[] defauts, string? saved) =>
        string.IsNullOrEmpty(saved) || defauts.Contains(saved)
            ? defauts.ToList()
            : defauts.Append(saved).ToList();

    var typesFacture = Opts(new[] { "Facture directe", "Facture sur commande", "Facture proforma" }, liv?.TypeFacture);
    var typesRetrait = Opts(new[] { "A livrer", "Retrait client" }, liv?.TypeRetrait);
    var causes = Opts(new[] { "Rupture de stock", "Retard de transport", "Client absent", "Autre incident" }, liv?.CauseNonTransfert);

    // Quantité TOTALE déjà livrée par article (cumul de toutes les validations de cette facture)
    var livreParArticle = historique
        .GroupBy(h => (h.ArRef ?? "").Trim(), StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.Sum(x => x.QteValidee), StringComparer.OrdinalIgnoreCase);

    // Une ligne n'est "validée" que si tout ce qui a été commandé est livré
    var nbValidees = Model == null ? 0 : Model.Count(l =>
    {
        livreParArticle.TryGetValue((l.ArRef ?? "").Trim(), out var liv);
        var cmd = Convert.ToDecimal(l.DlQte);
        return liv > 0 && liv >= cmd;
    });
}

@if (Model == null || Model.Count == 0)
{
    <em>Aucune ligne.</em>
}
else
{
    <div class="af-lignes"
         data-validateur="@validateur"
         data-piece="@noFacture">

        <!-- ===== Lignes de la facture ===== -->
        <div class="af-toolbar">
            <span class="af-toolbar-info">
                <strong class="af-compteur">@nbValidees</strong> / @Model.Count ligne(s) livrée(s)
            </span>
            <small style="color:#b00">[contrôle] @historique.Count validation(s) en base pour @noFacture</small>
            <button type="button" class="af-btn-tout-valider">Tout valider</button>
        </div>

        <table class="table table-sm mb-0 af-table"
               data-piece="@noFacture"
               data-url="@Url.Action("ValiderLigne", "Home")">
            <thead>
                <tr>
                    <th>N° Article</th>
                    <th>Description</th>
                    <th class="text-end">Qté commandée</th>
                    <th class="text-end">Qté préparée</th>
                    <th class="text-end">Reste à livrer</th>
                    <th class="text-end">Famille</th>
                    <th class="text-end">Statut</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    var cmd = Convert.ToDecimal(l.DlQte);
                    livreParArticle.TryGetValue((l.ArRef ?? "").Trim(), out var livre);

                    var resteLigne = Math.Max(cmd - livre, 0m);
                    var complete = livre > 0 && resteLigne == 0m;      // tout est livré
                    var partiel = livre > 0 && resteLigne > 0m;        // livré en partie

                    // Quantité proposée : le reste à livrer si déjà partiellement livré, sinon la commande
                    var qtePrepDef = partiel ? resteLigne : cmd;

                    var cmdStr = cmd.ToString("0.######", inv);
                    var livreStr = livre.ToString("0.######", inv);
                    var qtePrep = qtePrepDef.ToString("0.######", inv);
                    var resteAff = partiel ? resteLigne : 0m;

                    <tr data-ligne="@l.ArRef" data-design="@l.DlDesign"
                        data-commandee="@cmdStr" data-livre="@livreStr"
                        class="@(complete ? "ligne-validee" : null)"
                        data-valide="@(complete ? "1" : null)">
                        <td>@l.ArRef</td>
                        <td>@l.DlDesign</td>
                        <td class="text-end">@l.DlQte</td>
                        <td class="text-end">
                            <input type="number"
                                   class="af-qte-input"
                                   value="@(complete ? "0" : qtePrep)"
                                   data-original="@(complete ? "0" : qtePrep)"
                                   min="0"
                                   max="@(complete ? "0" : qtePrep)"
                                   step="any"
                                   disabled="@complete" />
                        </td>
                        <td class="text-end af-reste">@resteAff.ToString("0.###", fr)</td>
                        <td class="text-end">@l.FaCodeFamille</td>
                        <td class="text-end">
                            @if (complete)
                            {
                                <span class="af-statut af-statut-complet">Livrée</span>
                            }
                            else if (partiel)
                            {
                                <span class="af-statut af-statut-partiel">Partiel</span>
                            }
                            else
                            {
                                <span class="af-statut af-statut-attente">En attente</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="af-btn-valider" disabled="@complete">
                                @(complete ? "Livrée" : "Valider")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- ===== Informations de livraison (sauvegarde automatique) ===== -->
        <section class="af-card af-livraison"
                 data-url="@Url.Action("SauvegarderLivraison", "Home")">
            <div class="af-card-head">
                <h3 class="af-card-title">Informations de livraison</h3>
                <span class="af-save-status" role="status" aria-live="polite"></span>
            </div>
            <p class="af-card-sub">
                Renseignez au fur et à mesure de la préparation — ces informations alimentent
                automatiquement les exports Excel.
            </p>

            <div class="af-grid af-grid-4">
                <div class="af-field">
                    <label>Type de facture</label>
                    <select data-field="typeFacture">
                        @foreach (var o in typesFacture)
                        {
                            <option selected="@(o == liv?.TypeFacture)">@o</option>
                        }
                    </select>
                </div>
                <div class="af-field">
                    <label>Type de retrait</label>
                    <select data-field="typeRetrait">
                        @foreach (var o in typesRetrait)
                        {
                            <option selected="@(o == liv?.TypeRetrait)">@o</option>
                        }
                    </select>
                </div>
                <div class="af-field">
                    <label>Véhicule (N° immatriculation)</label>
                    <input type="text" data-field="vehicule" maxlength="30"
                           value="@liv?.Vehicule" placeholder="ex : 3475 TBP" />
                </div>
                <div class="af-field">
                    <label>Chauffeur / livreur</label>
                    <input type="text" data-field="chauffeur" maxlength="100"
                           value="@liv?.Chauffeur" placeholder="Nom du livreur" />
                </div>

                <div class="af-field">
                    <label>Date livraison réelle</label>
                    <input type="date" data-field="dateLivraison"
                           value="@(liv?.DateLivraison?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="af-field">
                    <label>
                        Date début préparation
                        <span class="af-hint">(auto : @autoDate — modifiable)</span>
                    </label>
                    <input type="date" data-field="dateDebutPrep"
                           value="@(liv?.DateDebutPrep?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="af-field">
                    <label>
                        Heure début préparation
                        <span class="af-hint">(auto : @autoHeure)</span>
                    </label>
                    <input type="time" data-field="heureDebutPrep"
                           value="@(liv?.HeureDebutPrep?.ToString(@"hh\:mm"))" />
                </div>
                <div class="af-field">
                    <label>Statut préparation (manuel)</label>
                    <select data-field="statutPrep">
                        <option value="" selected="@string.IsNullOrEmpty(liv?.StatutPrep)">— Auto (selon validation) —</option>
                        <option value="EnCours" selected="@(liv?.StatutPrep == "EnCours")">En cours</option>
                        <option value="Preparee" selected="@(liv?.StatutPrep == "Preparee")">Préparée</option>
                        <option value="Livree" selected="@(liv?.StatutPrep == "Livree")">Livrée</option>
                    </select>
                </div>
            </div>

            <div class="af-field af-field-full">
                <label>Cause de non-transfert (si retard ou incident)</label>
                <select data-field="causeNonTransfert">
                    <option value="" selected="@string.IsNullOrEmpty(liv?.CauseNonTransfert)">— Aucune —</option>
                    @foreach (var o in causes)
                    {
                        <option selected="@(o == liv?.CauseNonTransfert)">@o</option>
                    }
                </select>
            </div>

            <div class="af-field af-field-full">
                <label>Observations</label>
                <textarea data-field="observations" rows="3"
                      placeholder="Notes libres, incidents, précisions…">@liv?.Observations</textarea>
            </div>
        </section>

        <!-- ===== Historique de validation ===== -->
        <section class="af-card">
            <h3 class="af-card-title">Historique de validation</h3>
            <div class="af-histo-wrap">
                <table class="af-histo">
                    <thead>
                        <tr>
                            <th>N° Facture</th>
                            <th>Réf article</th>
                            <th>Heure de validation</th>
                            <th>Nom validateur</th>
                            <th>Désignation</th>
                            <th class="text-end">Qté validée</th>
                        </tr>
                    </thead>
                    <tbody class="af-histo-body">
                        @foreach (var h in historique)
                        {
                            <tr>
                                <td>@h.DoPiece</td>
                                <td>@h.ArRef</td>
                                <td>@h.DateValidation.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@h.Validateur</td>
                                <td>@h.Designation</td>
                                <td class="text-end">@h.QteValidee.ToString("0.###", fr)</td>
                            </tr>
                        }
                        <tr class="af-histo-vide" style="@(historique.Any() ? "display:none" : "")">
                            <td colspan="6" class="text-center text-muted">Aucune validation pour le moment.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        @Html.AntiForgeryToken()
    </div>
}