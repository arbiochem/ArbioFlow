@{
    Layout = null;
    ViewData["Title"] = "Connexion";
    var depots = ViewBag.Depots as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ArbioFlow</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <main class="card">
        <div class="card-top">
            <img src="~/img/logo.png" alt="Arbiochem Group" />
        </div>

        <div class="card-body">
            @if (TempData["Ok"] != null)
            {
                <div class="ok" role="status">@TempData["Ok"]</div>
            }
            @if (!string.IsNullOrEmpty(ViewBag.Erreur as string))
            {
                <div class="error" role="alert">@ViewBag.Erreur</div>
            }

            <form method="post" asp-controller="Home" asp-action="Login" id="connectForm" autocomplete="on">
                <div class="field">
                    <label for="utilisateur">Nom d'utilisateur</label>
                    <input type="text" id="utilisateur" name="utilisateur" value="@ViewBag.utilisateur"
                           placeholder="Votre identifiant" autocomplete="username" autofocus required />
                </div>

                <div class="field">
                    <label for="password">Mot de passe</label>
                    <div class="control">
                        <input type="password" id="password" name="password"
                               placeholder="Votre mot de passe" autocomplete="current-password" required />
                        <button type="button" class="toggle" id="togglePwd" aria-controls="password" aria-pressed="false">Afficher</button>
                    </div>
                </div>

                <div class="field">
                    <label for="depot">Dépôt</label>
                    <select id="depot" name="depot" required style="font-size: 0.85rem;">
                        <option value="" disabled selected="@(string.IsNullOrEmpty(ViewBag.depot as string))">-- Sélectionner un dépôt --</option>
                        @foreach (var d in depots)
                        {
                            <option value="@d.Value" selected="@(d.Value == (ViewBag.depot as string))">@d.Text</option>
                        }
                    </select>
                </div>

                <button type="submit" id="btnConnect" class="btn">Se connecter</button>
            </form>

            <div class="links">
                <a asp-controller="Home" asp-action="Inscription">Créer un compte</a>
                <a asp-controller="Home" asp-action="MotDePasseOublie">Mot de passe oublié ?</a>
            </div>
        </div>
    </main>

    <p class="credit">Développé par l'équipe <strong>IT Arbiochem</strong> &copy; @DateTime.Now.Year</p>

    <script>
        (function () {
            var input = document.getElementById('password');
            var btn = document.getElementById('togglePwd');
            btn.addEventListener('click', function () {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                input.classList.toggle('revealed', show);
                btn.textContent = show ? 'Masquer' : 'Afficher';
                btn.setAttribute('aria-pressed', show);
            });
        })();
    </script>
</body>
</html>